# ──────────────────────────────────────────────────────────────
# InkFlow — variables d'environnement (modèle).
# Copier ce fichier en .env.local puis remplir. NE JAMAIS committer .env.local.
# ──────────────────────────────────────────────────────────────

# URL publique du site, sans slash final. En local : http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase ───────────────────────────────────────────────────
# Dashboard Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
# Clé « publishable » (sb_publishable_…) — exposée au navigateur, sécurité par RLS
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clé « secret » (sb_secret_…) — SERVEUR UNIQUEMENT, bypasse la RLS. Ne jamais exposer.
SUPABASE_SECRET_KEY=

# ── Stripe ─────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Secret de signature du webhook (via `stripe listen` ou le dashboard)
STRIPE_WEBHOOK_SECRET=

# ── Resend (email transactionnel) ──────────────────────────────
RESEND_API_KEY=

# ── Twilio (SMS de rappel) ─────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=

# ── Rate limiting (optionnel — Upstash Redis) ──────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
